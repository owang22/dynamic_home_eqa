   "distinguishing_check": null,
   "markdown": "# p_c3d4 \u2014 Elena works from home three days a week; the office desk is her hub\n\nElena splits her week: Monday, Wednesday, and Friday she works from home at desk_o1 in the office. Tuesday and Thursday she commutes to the office in town (8:00\u201317:30). On WFH days her laptop, charger, pen, and notebook are at desk_o1 from about 8:30 to 17:00. On commute days they leave with her. Priya's routine is the same as any retired person: home all day, morning walk 8:00\u20139:00, afternoon errands 14:00\u201316:00. The key distinction: on Monday, Wednesday, and Friday the office (room o1) is occupied by Elena from roughly 8:30 to 17:00, and desk_o1 holds her laptop. On Tuesday and Thursday the office is empty and her gear is OUT_OF_HOUSE. What would refute it: laptop_elena sighted at coffee_table_l1 (not desk_o1) on a Monday between 10:00 and 15:00, or Elena not present in room o1 on a Wednesday afternoon.\n\n```json\n{\n \"claims\": [\n  {\n   \"claim\": \"Elena's laptop is at the office desk on Monday mornings\",\n   \"target\": \"laptop_elena\",\n   \"expect\": \"desk_o1\",\n   \"days\": \"weekday\",\n   \"from\": 9,\n   \"to\": 15\n  },\n  {\n   \"claim\": \"Elena's laptop is out of the house on Tuesday mornings\",\n   \"target\": \"laptop_elena\",\n   \"expect\": \"OUT_OF_HOUSE\",\n   \"days\": \"weekday\",\n   \"from\": 9,\n   \"to\": 15\n  },\n  {\n   \"claim\": \"The office desk holds her charger on a Wednesday afternoon\",\n   \"target\": \"charger_elena\",\n   \"expect\": \"desk_o1\",\n   \"days\": \"weekday\",\n   \"from\": 12,\n   \"to\": 16\n  },\n  {\n   \"claim\": \"Priya's water bottle is out of the house during her weekday errands\",\n   \"target\": \"water_bottle_priya\",\n   \"expect\": \"OUT_OF_HOUSE\",\n   \"days\": \"weekday\",\n   \"from\": 14,\n   \"to\": 16\n  }\n ],\n \"targets\": {\n  \"laptop_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"coffee_table_l1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8.5,\n    \"to\": 17,\n    \"at\": \"desk_o1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"charger_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"coffee_table_l1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8.5,\n    \"to\": 17,\n    \"at\": \"desk_o1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"pen_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"desk_b1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8.5,\n    \"to\": 17,\n    \"at\": \"desk_o1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"notebook_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"desk_b1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8.5,\n    \"to\": 17,\n    \"at\": \"desk_o1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"water_bottle_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"sink_k1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8.5,\n    \"to\": 17,\n    \"at\": \"desk_o1\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"wallet_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"entry_table_e1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   },\n   {\n    \"days\": \"weekend\",\n    \"from\": 12,\n    \"to\": 14,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"helmet_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"entry_hook_e1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   },\n   {\n    \"days\": \"weekend\",\n    \"from\": 14,\n    \"to\": 17,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"bike_lock_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"entry_table_e1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   },\n   {\n    \"days\": \"weekend\",\n    \"from\": 14,\n    \"to\": 17,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"backpack_elena\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"entry_hook_e1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"guitar_priya\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"bedroom_floor_b1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"both\",\n    \"from\": 19,\n    \"to\": 22,\n    \"at\": \"floor_l_l1\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"water_bottle_priya\": [\n   {\n    \"day