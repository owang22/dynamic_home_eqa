"toiletry_bag_yuki\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"bathroom_shelf_ba1\",\n    \"chance\": \"almost_always\"\n   }\n  ],\n  \"class:towel\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"towel_rack_ba1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"both\",\n    \"from\": 7,\n    \"to\": 9,\n    \"at\": \"bathroom_shelf_ba1\",\n    \"chance\": \"sometimes\"\n   }\n  ],\n  \"keys_yuki\": [\n   {\n    \"days\": \"both\",\n    \"from\": 0,\n    \"to\": 24,\n    \"at\": \"entry_floor_e1\",\n    \"chance\": \"usually\"\n   },\n   {\n    \"days\": \"weekday\",\n    \"from\": 8,\n    \"to\": 17.5,\n    \"at\": \"OUT_OF_HOUSE\",\n    \"chance\": \"almost_always\"\n   }\n  ]\n }\n}\n```\n"
