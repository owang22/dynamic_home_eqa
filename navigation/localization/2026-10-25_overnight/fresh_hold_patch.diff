+    def _hold_heading(self, odom):
+        """Cancel gyro drift in T (see HOLD): rotate T about the dog so its map position stays put."""
+        hd = self._hold
+        t, x, y, yaw = time.monotonic(), odom["pos"][0], odom["pos"][1], odom["yaw"]
+        prev, hd["prev"] = hd["prev"], (t, x, y, yaw)
+        hist = hd["hist"]
+        hist.append((t, x, y, yaw))
+        while hist and t - hist[0][0] > HOLD_STILL_S:
+            hist.popleft()
+        if prev is None or self.T is None or self.mapping or t - prev[0] > 1.0:
+            hd["since"] = None
+            return
+        h0 = hist[0]
+        still = (t - h0[0] >= 0.8 * HOLD_STILL_S and math.hypot(x - h0[1], y - h0[2]) < HOLD_STILL_M
+                 and abs(wrap(yaw - h0[3])) < math.radians(HOLD_TURN_DEG))
+        if still:
+            a = -wrap(yaw - prev[3])
+            if hd["since"] is None:
+                hd["since"] = (t, yaw)
+            elif t - hd["since"][0] >= HOLD_BIAS_MIN_S:
+                b = wrap(yaw - hd["since"][1]) / (t - hd["since"][0])
+                if abs(math.degrees(b) * 60) <= HOLD_BIAS_MAX:
+                    hd["bias"] = b
+        else:
+            hd["since"] = None
+            a = -hd["bias"] * (t - prev[0])
+        if a == 0.0:
+            return
+        tx, ty, th = self.T
+        c, s = math.cos(th), math.sin(th)
+        mx, my = tx + c * x - s * y, ty + s * x + c * y          # the dog on the map: stays put
+        th2 = wrap(th + a)
+        c2, s2 = math.cos(th2), math.sin(th2)
+        self._set_T((mx - (c2 * x - s2 * y), my - (s2 * x + c2 * y), th2), "drift_correction", hold=True)
+
