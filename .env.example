# ============================================================================
# dynamic_home_eqa — machine configuration.
# Copy to `.env` (repo root) and edit for THIS machine. `.env` is gitignored
# and auto-loaded by src/dynamic_home_eqa/paths.py at import time, so no
# manual `export` is needed for Python. For shell scripts, `source env.sh`.
# Everything here is optional — unset falls back to the documented default.
# ============================================================================

# --- Repo location (usually auto-derived; set only if importing from elsewhere)
# DYNAMIC_HOME_EQA_ROOT=/abs/path/to/dynamic_home_eqa

# --- External data (THE two paths that always change between machines) --------
# HSSD scene dataset (the habitat scene_datasets/hssd-hab dir).
HSSD_DIR=/data/oliver/robot/EXPRESS-Bench/data/versioned_data/hssd-hab
# HuggingFace cache for large model weights (serve_llm/llm_prior use as HF_HOME).
DYNAMIC_EQA_HF_HOME=/data/oliver/huggingface_cache

# --- Local LLM serving (vLLM OpenAI-compatible endpoint) ----------------------
# Endpoint the generation + agent code calls. Empty = in-process vLLM (needs
# the model loadable in the current env). Set to the served URL to use serve_llm.
GENERATION_ENDPOINT=http://127.0.0.1:8300
# Default local model id (served + generation).
GENERATION_MODEL=Qwen/Qwen3.6-35B-A3B
# Python interpreter used for subprocess generation calls (defaults to the
# running interpreter). Set if generation must run in a different conda env.
# DYNAMIC_EQA_GEN_PYTHON=/home/USER/miniconda3/envs/dynamic_eqa/bin/python

# --- Frontier API models (OpenAI) --------------------------------------------
# Either set the key here, or put it (one line) in the keyfile below.
# OPENAI_API_KEY=sk-...
DYNAMIC_EQA_OPENAI_KEYFILE=~/.config/dynamic_eqa/openai_key

# --- GPU / rendering ----------------------------------------------------------
# DYNAMIC_EQA_RENDER_GPU=0

# --- Webapp / eval dirs (rarely changed) -------------------------------------
# EVAL_INDEX_DIR=./eval_index
# EVAL_BROWSER_DATA_DIR=./results/eval_browser
# EVAL_BROWSER_ADMIN_KEY=
# REALISM_DATA_DIR=./results/realism_eval
# REALISM_MEDIA_DIR=./results/reports/realism_eval_media
