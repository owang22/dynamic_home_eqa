# Copy to robot.env (not committed) and fill in.
# The dog's address: 192.168.12.1 on its own hotspot; otherwise the app shows it under
# Device -> Data -> Automatic Machine Inspection -> STA Network: wlan0
ROBOT_IP=192.168.12.1
# Only for firmware 1.1.15 or later (check_connection.py says whether it is needed):
# the 32 hex characters from  unitree-fetch-aes-key --email <the dog's account> --device-type Go2
GO2_AES_KEY=
# true if a game controller is plugged into this computer
JOYSTICK=false
# ROS domain for this computer's containers. Leave at 42: the lab driver on the control PC
# (172.17.40.64) uses 78, and sharing it would let this computer's commands reach the dog.
ROS_DOMAIN_ID=42
