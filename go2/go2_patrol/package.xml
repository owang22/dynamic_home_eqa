<?xml version="1.0"?>
<package format="3">
  <name>go2_patrol</name>
  <version>0.1.0</version>
  <description>Record named positions in the lab map and photograph them on a patrol (object-search study)</description>
  <maintainer email="owang235@gmail.com">Oliver</maintainer>
  <license>BSD-3-Clause</license>
  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>go2_interfaces</depend>
  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
